# ---------- Core ----------
# MongoDB connection string (never expose to the browser)
MONGODB_URI=mongodb://127.0.0.1:27017/derms
# Long random secret used to sign session cookies and WebSocket tokens (min 32 chars)
AUTH_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Public URL of the web app (used for Origin checks)
APP_URL=http://localhost:3000

# ---------- First-run Admin bootstrap (used only when no admin exists) ----------
ADMIN_NAME=System Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ---------- MQTT (realtime service only; never sent to the browser) ----------
# Leave MQTT_URL empty to run the CRM without live data (the UI shows "MQTT disabled").
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=b25saW5lcmVzbW9uaXRvcg==
# How the "data" field of the envelope is encoded: auto | base64 | json
MQTT_PAYLOAD_ENCODING=auto

# ---------- Realtime WebSocket service ----------
REALTIME_PORT=3001
# Browser-facing WebSocket URL of the realtime service
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001
# Persistence policy: snapshot (default) | raw
READING_HISTORY_MODE=snapshot
# A Node is marked offline when no message arrives for this many seconds
NODE_OFFLINE_AFTER_SECONDS=120
