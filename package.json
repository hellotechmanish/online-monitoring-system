{
  "name": "derms",
  "version": "2.0.0",
  "private": true,
  "description": "DERMS - Online Resistance Monitoring System (Next.js CRM + MQTT/WebSocket realtime service)",
  "scripts": {
    "dev": "concurrently -k -n web,realtime -c blue,magenta \"npm:dev:web\" \"npm:dev:realtime\"",
    "dev:web": "next dev -p 3000",
    "dev:realtime": "tsx watch --clear-screen=false src/realtime/index.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "start:realtime": "tsx src/realtime/index.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx scripts/e2e.ts",
    "mqtt:local-broker": "tsx scripts/local-broker.ts",
    "mqtt:publish-sample": "tsx scripts/publish-sample.ts",
    "users:migrate-usernames": "tsx scripts/migrate-usernames.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-popover": "1.1.2",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "jose": "5.9.6",
    "lucide-react": "0.460.0",
    "mongoose": "8.8.1",
    "mqtt": "5.10.3",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "recharts": "2.13.3",
    "sonner": "1.7.0",
    "tailwind-merge": "2.5.4",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.3",
    "aedes": "0.51.3",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=18.18"
  }
}
